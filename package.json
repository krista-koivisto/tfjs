{
  "private": false,
  "scripts": {
    "build": "yarn workspaces foreach --all --topological run build",
    "clean": "yarn workspaces foreach --all run clean && rm -rf node_modules dist yarn.lock .yarn/cache .yarn/install-state.gz",
    "publish-local": "yarn workspaces foreach --all --topological run publish-local",
    "unpublish-local": "yarn workspaces foreach --all --topological run unpublish-local",
    "bump-version": "yarn workspaces foreach --all --topological run bump-version"
  },
  "workspaces": [
    "tfjs-core",
    "tfjs",
    "tfjs-node",
    "tfjs-node-gpu"
  ],
  "devDependencies": {
    "@webgpu/types": "^0.1.38",
    "typescript": "^5.0.4",
    "yalc": "^1.0.0-pre.53"
  },
  "__comment": "[node-pre-gyp] -> [nmplog] -> [gauge] -> [wide-align] -> [string-width] requires pre-ESM version of string-width.",
  "resolutions": {
    "string-width": "4.2.3"
  },
  "packageManager": "yarn@4.9.2"
}
