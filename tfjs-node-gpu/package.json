{
  "name": "@tensorflow/tfjs-node-gpu",
  "version": "4.2.27",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "gypfile": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/tensorflow/tfjs.git",
    "directory": "tfjs-node-gpu"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=8.11.0"
  },
  "scripts": {
    "build": "yarn clean && ncp ../tfjs-node/dist dist",
    "build:addon": "node-pre-gyp install --build-from-source",
    "install": "node scripts/install.cjs gpu download",
    "publish-local": "yalc publish --push",
    "clean": "rm -rf dist && rm -rf node_modules",
    "bump-version": "yarn version patch"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "ncp": "^2.0.0"
  },
  "dependencies": {
    "@mapbox/node-pre-gyp": "1.0.9",
    "@tensorflow/tfjs": "workspace:^",
    "@tensorflow/tfjs-core": "workspace:^",
    "adm-zip": "^0.5.2",
    "google-protobuf": "^3.9.2",
    "https-proxy-agent": "^2.2.1",
    "progress": "^2.0.0",
    "tar": "^6.2.1"
  },
  "binary": {
    "module_name": "tfjs_binding",
    "module_path": "./lib/napi-v{napi_build_version}",
    "host": "https://storage.googleapis.com/tf-builds/pre-built-binary",
    "remote_path": "./napi-v{napi_build_version}/{version}/",
    "napi_versions": [
      3,
      4,
      5,
      6,
      7,
      8,
      9
    ],
    "package_name": "GPU-windows-4.2.27.zip"
  }
}
