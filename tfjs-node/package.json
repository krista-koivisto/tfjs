{
  "name": "@tensorflow/tfjs-node",
  "version": "4.2.27",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "gypfile": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/tensorflow/tfjs.git",
    "directory": "tfjs-node"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=8.11.0"
  },
  "scripts": {
    "build": "tsc -p . && npx mkdirp dist/proto && cp src/proto/api_pb.js dist/proto/api_pb.js",
    "clean": "rm -rf dist && rm -rf node_modules",
    "build:addon": "node-pre-gyp install --build-from-source",
    "install": "node scripts/install.cjs",
    "publish-local": "yarn version patch && yalc publish --push"
  },
  "devDependencies": {
    "@types/node": "^18.0.0"
  },
  "dependencies": {
    "@mapbox/node-pre-gyp": "1.0.9",
    "@tensorflow/tfjs": "workspace:^",
    "@tensorflow/tfjs-core": "workspace:^",
    "adm-zip": "^0.5.2",
    "google-protobuf": "^3.9.2",
    "https-proxy-agent": "^2.2.1",
    "progress": "^2.0.0",
    "tar": "^6.2.1"
  },
  "binary": {
    "module_name": "tfjs_binding",
    "module_path": "./lib/napi-v{napi_build_version}",
    "host": "https://storage.googleapis.com/tf-builds/pre-built-binary",
    "remote_path": "./napi-v{napi_build_version}/{version}/",
    "napi_versions": [
      3,
      4,
      5,
      6,
      7,
      8,
      9
    ],
    "package_name": "CPU-windows-0.0.0.zip"
  }
}
