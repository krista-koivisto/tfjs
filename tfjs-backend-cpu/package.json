{
  "name": "@tensorflow/tfjs-backend-cpu",
  "version": "4.2.22",
  "description": "Vanilla JavaScript backend for TensorFlow.js",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "jsdelivr": "dist/tf-backend-cpu.min.js",
  "unpkg": "dist/tf-backend-cpu.min.js",
  "types": "dist/index.d.ts",
  "jsnext:main": "dist/index.js",
  "module": "dist/index.js",
  "miniprogram": "dist/miniprogram",
  "engines": {
    "yarn": ">= 1.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tensorflow/tfjs.git",
    "directory": "tfjs-backend-cpu"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -p .",
    "clean": "rm -rf dist && rm -rf node_modules",
    "publish-local": "yarn version patch && yalc publish --push"
  },
  "dependencies": {
    "@types/seedrandom": "^2.4.28",
    "seedrandom": "^3.0.5"
  },
  "peerDependencies": {
    "@tensorflow/tfjs-core": "*"
  },
  "browser": {
    "crypto": false,
    "util": false
  },
  "sideEffects": [
    "./dist/index.js"
  ],
  "resolutions": {
    "minimist": "1.2.6"
  }
}
