{
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "sourceMap": true,
    "target": "es2017",
    "lib": ["es2019", "dom"],
    // "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  }
}
