{
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "target": "es2017",
    "lib": ["es2019"],
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  }
}
