{
  "name": "@tensorflow/tfjs-core",
  "version": "4.22.9",
  "description": "Hardware-accelerated JavaScript library for machine intelligence",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "private": false,
  "engines": {
    "yarn": ">= 1.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tensorflow/tfjs.git",
    "directory": "tfjs-core"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/jasmine": "~4.0.3"
  },
  "scripts": {
    "build": "npx tsc -p .",
    "clean": "rm -rf dist && rm -rf node_modules",
    "publish-local": "yalc publish --push",
    "bump-version": "yarn version patch",
    "unpublish-local": "yalc installations clean @tensorflow/tfjs-core"
  },
  "dependencies": {
    "@types/long": "^4.0.1",
    "@types/offscreencanvas": "~2019.7.0",
    "@types/seedrandom": "^2.4.28",
    "@webgpu/types": "0.1.38",
    "long": "4.0.0",
    "node-fetch": "~2.6.1",
    "seedrandom": "^3.0.5"
  },
  "browser": {
    "crypto": false,
    "node-fetch": false,
    "util": false,
    "worker_threads": false
  },
  "sideEffects": [
    "./dist/index.js"
  ],
  "resolutions": {
    "minimist": "1.2.6"
  }
}
